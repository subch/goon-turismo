---
import Base from '../../layouts/Base.astro';
import LeaderboardTable from '../../components/LeaderboardTable.astro';
import { allEvents, resultsForEvent, eventLabel, eventDateLabel, wikiUrl } from '../../lib/data';

export function getStaticPaths() {
  return allEvents.map((event) => ({
    params: { id: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const results = resultsForEvent(event.id);
const trackWikiUrl = wikiUrl(event.track);
const carWikiUrl = wikiUrl(event.car);
const sourceLabel =
  event.source === 'custom'
    ? 'Custom'
    : event.source === 'gridstats'
      ? 'GT-GridStats'
      : event.source === 'historical'
        ? 'Historical'
        : 'dg-edge';
---
<Base title={eventLabel(event)}>
  <span class={`badge ${event.source}`}>{sourceLabel}</span>
  <h1>{eventLabel(event)}</h1>
  <p class="subtitle">
    {event.track && (trackWikiUrl ? <a href={trackWikiUrl} target="_blank" rel="noopener">{event.track}</a> : <>{event.track}</>)}
    {event.car && <> · {carWikiUrl ? <a href={carWikiUrl} target="_blank" rel="noopener">{event.car}</a> : event.car}</>}
    {' '}· {eventDateLabel(event)}
    {event.dgEdgeUrl && <> · <a href={event.dgEdgeUrl} target="_blank" rel="noopener">view on dg-edge.com</a></>}
  </p>

  {event.notes && <p>{event.notes}</p>}

  <div class="panel">
    <LeaderboardTable results={results} />
  </div>
</Base>
