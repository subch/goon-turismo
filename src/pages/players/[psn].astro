---
import Base from '../../layouts/Base.astro';
import { players, resultsForPlayer, eventById, eventLabel, standings, currentSeason, seasons } from '../../lib/data';

export function getStaticPaths() {
  return players.map((p) => ({
    params: { psn: p.psn },
    props: { player: p },
  }));
}

const { player } = Astro.props;
const seasonById = new Map(seasons.map((s) => [s.id, s]));
// `seasons` is already ordered current-first, then historical newest-to-oldest,
// so sorting by that position gives a clean season grouping without needing to
// parse two different date formats (historical events store ISO dates, live
// GT-GridStats-scraped ones store "06 Aug 2026" style strings).
const seasonOrder = new Map(seasons.map((s, i) => [s.id, i]));
const results = resultsForPlayer(player.psn).sort((a, b) => {
  const seasonA = seasonOrder.get(eventById(a.eventId)?.seasonId ?? '') ?? 999;
  const seasonB = seasonOrder.get(eventById(b.eventId)?.seasonId ?? '') ?? 999;
  if (seasonA !== seasonB) return seasonA - seasonB;
  return (a.groupRank ?? 999) - (b.groupRank ?? 999);
});
const allTimePoints = results.reduce((sum, r) => sum + (r.points ?? 0), 0);
const cur = currentSeason();
const currentStanding = cur ? standings(cur.id).find((row) => row.psn === player.psn) : undefined;
const stats = player.stats;
const gs = player.gridstats;
---
<Base title={player.displayName}>
  <h1>{player.displayName}</h1>
  <p class="subtitle">PSN: {player.psn}{player.dgEdgeUrl && <> · <a href={player.dgEdgeUrl} target="_blank" rel="noopener">dg-edge profile</a></>}</p>

  <div class="grid">
    <div class="card">
      <div class="meta">{cur?.name ?? 'Current season'} points</div>
      <h3>{currentStanding?.points ?? 0}</h3>
    </div>
    <div class="card">
      <div class="meta">{cur?.name ?? 'Current season'} events</div>
      <h3>{currentStanding?.events ?? 0}</h3>
    </div>
    <div class="card">
      <div class="meta">All-time points (every season, no drops)</div>
      <h3>{allTimePoints}</h3>
    </div>
    <div class="card">
      <div class="meta">All-time events entered</div>
      <h3>{results.length}</h3>
    </div>
    {gs?.dr != null && (
      <div class="card">
        <div class="meta">DR / SR (GT-GridStats)</div>
        <h3>{gs.dr} / {gs.sr ?? '—'}</h3>
      </div>
    )}
    {stats?.edgeScore != null && (
      <div class="card">
        <div class="meta">dg-edge Edge Score</div>
        <h3>{stats.edgeScore}</h3>
      </div>
    )}
    {stats?.globalPosition != null && (
      <div class="card">
        <div class="meta">dg-edge Global Position</div>
        <h3>#{stats.globalPosition}</h3>
      </div>
    )}
  </div>

  <h2>Event history</h2>
  <div class="panel">
    {results.length === 0 ? (
      <div class="empty-state">No results recorded yet.</div>
    ) : (
      <table>
        <thead>
          <tr>
            <th>Season</th>
            <th>Event</th>
            <th>Rank</th>
            <th>Time</th>
            <th>Points</th>
          </tr>
        </thead>
        <tbody>
          {results.map((r) => {
            const ev = eventById(r.eventId);
            const season = ev?.seasonId ? seasonById.get(ev.seasonId) : undefined;
            return (
              <tr>
                <td class="meta">{season?.name ?? '—'}</td>
                <td>{ev ? <a href={`/events/${ev.id}/`}>{eventLabel(ev)}</a> : r.eventId}</td>
                <td>{r.groupRank ?? '—'}</td>
                <td>{r.timeRaw ?? '—'}</td>
                <td>{r.points}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    )}
  </div>

  {gs?.lastSynced && <p class="subtitle" style="margin-top:20px;">GT-GridStats last synced: {new Date(gs.lastSynced).toLocaleString()}</p>}
  {stats?.lastScraped && <p class="subtitle">dg-edge stats last refreshed: {new Date(stats.lastScraped).toLocaleString()}</p>}
</Base>
