---
import Base from '../../layouts/Base.astro';
import SeasonStandings from '../../components/SeasonStandings.astro';
import { seasons } from '../../lib/data';

export function getStaticPaths() {
  return seasons.map((s) => ({
    params: { id: s.id },
    props: { season: s },
  }));
}

const { season } = Astro.props;
---
<Base title={season.name}>
  <h1>{season.name}</h1>
  <SeasonStandings season={season} />
</Base>
