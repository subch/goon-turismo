---
import Base from '../layouts/Base.astro';
import SeasonStandings from '../components/SeasonStandings.astro';
import { currentSeason } from '../lib/data';

const season = currentSeason();
---
<Base title="Standings">
  <h1>{season ? season.name : 'Season'} Standings</h1>
  {season && <SeasonStandings season={season} />}
</Base>
