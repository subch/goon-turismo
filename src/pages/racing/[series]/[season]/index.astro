---
import Base from '../../../../layouts/Base.astro';
import SeriesSeason from '../../../../components/racing/SeriesSeason.astro';
import { seriesList } from '../../../../lib/racing';

export function getStaticPaths() {
  return seriesList().flatMap((s) =>
    s.seasons.map((season) => ({
      params: { series: s.id, season: String(season) },
      props: { seasons: s.seasons },
    })),
  );
}

const { series, season } = Astro.params;
const { seasons } = Astro.props;
import { seasonFile } from '../../../../lib/racing';
const file = seasonFile(series!, Number(season))!;
---
<Base title={`${file.name} ${file.seasonLabel ?? file.season}`} description={`${file.name} ${file.seasonLabel ?? file.season} results, schedule and standings.`}>
  <SeriesSeason file={file} seasons={seasons} />
</Base>
